build/
dist/

# Local legal datasets
# Raw and derived corpora are reproducible and should not be committed.
data/raw/*
data/processed/*
data/chunks/*

# Keep directory placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/chunks/.gitkeep

# Evaluation outputs
evaluation/results/*
!evaluation/results/.gitkeep
