# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.envrc

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

